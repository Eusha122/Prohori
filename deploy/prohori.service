[Unit]
Description=Prohori web app (FastAPI on port 8000, behind Caddy)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/prohori
EnvironmentFile=/opt/prohori/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/prohori/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
